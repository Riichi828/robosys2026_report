import sys
import statistics

data = []

for line in sys.stdin:
    for item in line.split():
        try:
            data.append(float(item))
        except ValueError:
            print(f"エラー: 数値以外の値が含まれています -> '{item}'", file=sys.stderr)
            sys.exit(1)

if not data:
    print("エラー: データが入力されていません", file=sys.stderr)
    sys.exit(1)

print(f"データ数: {len(data)}")
print(f"合計値  : {sum(data)}")
print(f"平均値  : {statistics.mean(data)}")
print(f"中央値  : {statistics.median(data)}")
print(f"最小値  : {min(data)}")
print(f"最大値  : {max(data)}")

if len(data) >= 2:
    print(f"標準偏差: {statistics.stdev(data)}")
